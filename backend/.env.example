PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://database-host/database-name?sslmode=require
SPRING_DATASOURCE_USERNAME=database-user
SPRING_DATASOURCE_PASSWORD=replace-locally
JWT_SECRET=replace-locally-with-at-least-32-random-bytes
JWT_EXPIRATION_SECONDS=7200
CORS_ALLOWED_ORIGINS=http://localhost:4200
